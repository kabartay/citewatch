{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kabartay/citewatch/schemas/zenodo.schema.json",
  "title": ".zenodo.json for Zenodo's GitHub integration",
  "description": "Deposit metadata Zenodo reads from a repository on each GitHub release. Citewatch checks the rules a schema cannot, such as the licence vocabulary and ORCID checksums.",
  "type": "object",
  "required": ["upload_type", "title", "description", "creators", "license", "access_right"],
  "properties": {
    "upload_type": {
      "description": "What is being archived. For code, \"software\".",
      "enum": ["publication", "poster", "presentation", "dataset", "image", "video", "software", "lesson", "physicalobject", "other"]
    },
    "title": { "type": "string", "minLength": 1, "description": "The record's title." },
    "description": { "type": "string", "minLength": 1, "description": "The record's description; HTML is allowed." },
    "creators": {
      "type": "array",
      "minItems": 1,
      "description": "The authors, in citation order.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "\"Family, Given\"." },
          "affiliation": { "type": "string" },
          "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$", "description": "Bare ORCID, e.g. 0000-0002-1825-0097." }
        }
      }
    },
    "license": {
      "description": "A lowercase SPDX id from Zenodo's licence vocabulary, e.g. \"mit\" or \"apache-2.0\".",
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9.+-]+$" },
        { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }
      ]
    },
    "access_right": { "enum": ["open", "embargoed", "restricted", "closed"], "description": "Usually \"open\"." },
    "version": { "type": "string", "description": "The version without a leading \"v\": the tag carries the v." },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "related_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "relation"],
        "properties": {
          "identifier": { "type": "string" },
          "relation": { "type": "string" },
          "scheme": { "type": "string" },
          "resource_type": { "type": "string" }
        }
      }
    },
    "communities": { "type": "array", "items": { "type": "object", "properties": { "identifier": { "type": "string" } } } },
    "language": { "type": "string" },
    "notes": { "type": "string" }
  }
}
